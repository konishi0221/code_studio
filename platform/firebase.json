{
  "hosting": {
    "public": "apps",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/server/**",
      "**/infra/**",
      "**/cloudbuild.yaml",
      "**/app.yaml",
      "**/*.md"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      }
    ]
  }
}
